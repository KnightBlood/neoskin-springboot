<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>com.neoskin</groupId>
  <artifactId>neoskin-springboot</artifactId>
  <version>6.0.11_patch-SNAPSHOT</version>
  <name>NeoSkin Spring Boot</name>
  <description>Blessing Skin Server 6.0.11_patch ported to Java 21 + Spring Boot 4.1 + Vert.x 5</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <!-- Web 层：Vert.x 取代 Tomcat / Jetty / Undertow（见 AGENTS.md §4.4） -->
    <vertx.version>5.2.2</vertx.version>
    <!-- 插件系统 -->
    <pf4j.version>3.13.0</pf4j.version>
    <!-- WebP 编码器（TextureController 探测 ImageIO writer） -->
    <webp-imageio.version>0.2.2</webp-imageio.version>
    <!-- Redis 客户端（CACHE_DRIVER=redis） -->
    <jedis.version>5.2.0</jedis.version>
    <!-- Memcached 客户端（CACHE_DRIVER=memcached） -->
    <spymemcached.version>2.12.3</spymemcached.version>
    <!-- AWS SDK（DynamoDB 缓存 / 未来的 S3 盘） -->
    <awssdk.version>2.31.0</awssdk.version>
    <!-- Argon2i 校验（PWD_METHOD=ARGON2I） -->
    <bouncycastle.version>1.86</bouncycastle.version>
    <!-- CommunicationRenderer：GFM markdown（对应 league/commonmark 2.10.4）+ HTML 消毒 -->
    <commonmark.version>0.24.0</commonmark.version>
    <jsoup.version>1.18.3</jsoup.version>
  </properties>

  <dependencies>
    <!-- ==================== Spring Boot 核心（无 Servlet 容器） ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-json</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- ==================== Web 层：Vert.x ==================== -->
    <!-- 只引入 vertx-web（内嵌 vertx-core + Netty），绝不引入任何 Servlet 容器 -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <version>2.6</version>
    </dependency>
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-web</artifactId>
      <version>${vertx.version}</version>
    </dependency>
    <!-- 用于插件市场 / 版本更新检查 / OAuth 端点转发等出站 HTTP -->
    <dependency>
      <groupId>io.vertx</groupId>
      <artifactId>vertx-web-client</artifactId>
      <version>${vertx.version}</version>
    </dependency>

    <!-- ==================== 模板：Thymeleaf（standalone，无 Servlet） ==================== -->
    <!-- 直接依赖 thymeleaf-spring6，避免 spring-boot-starter-thymeleaf 拉入 web 自动配置 -->
    <dependency>
      <groupId>org.thymeleaf</groupId>
      <artifactId>thymeleaf-spring6</artifactId>
    </dependency>
    <!-- Thymeleaf 3.1 的标准方言在运行时需要 OGNL（spring6 模块把它标成了
         optional/provided，本地仓库默认没有）。版本必须与 thymeleaf-parent
         里声明的 ognl.version 一致（3.1.5 → 3.3.4），否则表达式求值会
         NoClassDefFoundError: ognl/PropertyAccessor。 -->
    <dependency>
      <groupId>ognl</groupId>
      <artifactId>ognl</artifactId>
      <version>3.3.4</version>
    </dependency>

    <!-- ==================== 插件系统 ==================== -->
    <dependency>
      <groupId>org.pf4j</groupId>
      <artifactId>pf4j</artifactId>
      <version>${pf4j.version}</version>
    </dependency>

    <!-- Redis 缓存（CACHE_DRIVER=redis） -->
    <dependency>
      <groupId>redis.clients</groupId>
      <artifactId>jedis</artifactId>
      <version>${jedis.version}</version>
    </dependency>

    <!-- Memcached 缓存/会话（CACHE_DRIVER=memcached） -->
    <dependency>
      <groupId>net.spy</groupId>
      <artifactId>spymemcached</artifactId>
      <version>${spymemcached.version}</version>
    </dependency>

    <!-- DynamoDB 缓存（CACHE_DRIVER=dynamodb；含 DynamoDB Local 测试） -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>dynamodb</artifactId>
      <version>${awssdk.version}</version>
    </dependency>
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>url-connection-client</artifactId>
      <version>${awssdk.version}</version>
    </dependency>
    <!-- S3 纹理盘（FS_DRIVER=s3） -->
    <dependency>
      <groupId>software.amazon.awssdk</groupId>
      <artifactId>s3</artifactId>
      <version>${awssdk.version}</version>
    </dependency>

    <!-- WebP 编码/解码（源用 GD 的 IMG_WEBP；TextureController 会探测 writer） -->
    <dependency>
      <groupId>com.github.gotson</groupId>
      <artifactId>webp-imageio</artifactId>
      <version>${webp-imageio.version}</version>
    </dependency>

    <!-- ==================== 密码哈希 ==================== -->
    <!-- bcrypt：Spring Security 的 BCrypt 原生支持 $2a$ / $2b$ / $2y$（PHP 用 $2y$），
         且与后续 OAuth2 client secret 的哈希共用同一实现 -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>    <!-- ARGON2I 校验（PWD_METHOD=ARGON2I 的历史站点） -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <version>${bouncycastle.version}</version>
    </dependency>

    <!-- ==================== JDBC 驱动（5 种数据库） ==================== -->
    <!-- MySQL -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- MariaDB -->
    <dependency>
      <groupId>org.mariadb.jdbc</groupId>
      <artifactId>mariadb-java-client</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- PostgreSQL -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- SQL Server -->
    <dependency>
      <groupId>com.microsoft.sqlserver</groupId>
      <artifactId>mssql-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- SQLite -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Hibernate 社区方言：提供 SQLiteDialect -->
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-community-dialects</artifactId>
    </dependency>

    <!-- ==================== 邮件（忘记密码 / 邮箱验证） ==================== -->
    <!-- 源用 Illuminate\Mail（SwiftMailer/Symfony Mailer）；这里用 Jakarta Mail 直连
         config/mail.php 的 SMTP 配置。jakarta.mail-api 只给接口，angus-mail 提供
         实现（内含 smtp 协议实现，all-in-one jar）。 -->
    <dependency>
      <groupId>jakarta.mail</groupId>
      <artifactId>jakarta.mail-api</artifactId>
      <version>2.1.5</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.angus</groupId>
      <artifactId>angus-mail</artifactId>
      <version>2.0.5</version>
      <scope>runtime</scope>
    </dependency>

    <!-- ==================== 渲染（公告/站内信内容） ==================== -->
    <!-- league/commonmark 2.10.4（GFM）的 Java 对应；需要 tables/strikethrough/autolink -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-tables</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-strikethrough</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-autolink</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-task-list-items</artifactId>
      <version>${commonmark.version}</version>
    </dependency>
    <!-- CommunicationRenderer 的 sanitize/importBlocks：PHP DOMDocument 的对应 -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>${jsoup.version}</version>
    </dependency>

    <!-- ==================== 测试 ==================== -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <!-- 非 web 应用：mainClass 由 spring-boot-maven-plugin 自动探测 -->
          <mainClass>com.neoskin.NeoSkinApplication</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <release>${java.version}</release>
          <parameters>true</parameters>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
      <!--
        预编译前端产物（源 public/app，108 个文件）直接打进 jar：
        classpath:/static/app/** —— 不再依赖 scripts/prepare-public.ps1。
        源目录不存在时 maven-resources-plugin 会跳过，不影响纯后端构建/测试。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-prebuilt-frontend</id>
            <phase>process-resources</phase>
            <goals>
              <goal>copy-resources</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.outputDirectory}/static</outputDirectory>
              <resources>
                <resource>
                  <directory>${project.basedir}/../blessing-skin-server-Laravel13/public/app</directory>
                  <targetPath>app</targetPath>
                  <filtering>false</filtering>
                </resource>
              </resources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>central</id>
      <url>https://repo1.maven.org/maven2</url>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>
</project>
