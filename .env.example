APP_NAME=NeoSkin
APP_ENV=local
APP_DEBUG=true
# Laravel 兼容：base64: + 32 字节密钥。可用 `openssl rand -base64 32` 生成
APP_KEY=
APP_URL=http://127.0.0.1:8799
APP_HOST=127.0.0.1
APP_PORT=8799

# legacy | next
FRONTEND_MODE=legacy

# sqlite / mysql / mariadb / pgsql / sqlsrv
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=
DB_PREFIX=

# 可选：优先级高于 DB_*
# DATABASE_URL=mysql://user:pass@127.0.0.1:3306/blessing_skin

DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

STORAGE_PATH=storage
TEXTURES_PATH=storage/textures
CACHE_DIR=storage/framework/cache

MAIL_DRIVER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=NeoSkin
